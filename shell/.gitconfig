[user]
    email = hishamzakwan@gmail.com
    name = zakwan hisham
[core]
    editor = nvim
    pager = delta
    commentChar = ";"
[alias]
    a = add
    c = commit
    co = checkout
    d = diff
    p = push
    s = status
    st = status
    lg = log --oneline
    last = log -1 HEAD
[merge]
    tool = nvim
    conflictstyle = zdiff3
[mergetool]
    keepBackup = false
    prompt = false
[mergetool "nvim"]
    cmd = "nvim -d -c \"wincmd l\" -c \"norm ]c\" \"$LOCAL\" \"$MERGED\" \"$REMOTE\""
[help]
    autocorrect = prompt
[color]
    ui = auto
[init]
    defaultBranch = main
[pull]
    rebase = false
[interactive]
    diffFilter = delta --color-only
[delta]
    true-color = always
    syntax-theme = ansi
    navigate = true
    dark = true
    line-numbers = true
    side-by-side = true
