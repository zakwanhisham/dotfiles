[user]
    email = hishamzakwan@gmail.com
    name = zakwan hisham
[core]
    editor = nvim
    commentChar = ";"
[alias]
    a = add
    c = commit
    co = checkout
    d = diff
    p = push
    s = status
    st = status
    lg = log --oneline
    last = log -1 HEAD
[merge]
    tool = nvim
    conflictstyle = zdiff3
[mergetool]
    keepBackup = false
    prompt = true
[mergetool "nvim"]
    cmd = "nvim -d"
[help]
    autocorrect = prompt
[color]
    ui = auto
[init]
    defaultBranch = main
[pull]
    rebase = false
