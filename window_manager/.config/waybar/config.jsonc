{
    "bar-id": "bar-0",
    "ipc": true,
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,
    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "sway/scratchpad",
        "cpu",
        "memory",
        "disk",
        "custom/gpu-usage",
        "pulseaudio",
        "tray"
    ],
    "sway/workspaces": {
        "format": "{index}",
        "on-click": "activate",
        "enable-bar-scroll": true
    },
    "clock": {
        "format": "{:%A %d %b %H:%M:%S}",
        "interval": 1,
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "on-scroll"     : 1,
            "on-click-right": "mode",
            "iso8601": true,
            "format": {
                "months":     "<span color='#ffead3'><b>{}</b></span>",
                "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "sway/scratchpad": {
        "format": "[{count}] :: "
    },
    "sway/mode": {
        "format": "{}",
   		"tooltip": false
    },
    "cpu": {
        "format": "cpu {usage}% :: ",
        "interval": 2,
        "on-click": "alacritty -T \"System Monitor (btop)\" -e btop"
    },
    "memory": {
        "format": "mem {percentage}% :: ",
        "interval": 2
    },
    "disk": {
        "format": "dsk {free} :: ",
        "interval": 10
    },
    "custom/gpu-usage": {
        "format": "gpu {} :: ",
        "exec": "gpu-usage-waybar",
        "return-type": "json",
        "on-click": "amdgpu_top --gui"
    },
    "pulseaudio": {
        "format": "vol {volume}%{icon} :: ",
        "format-muted": "vol MUTE :: ",
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    "tray": {
        "icon-size": 14,
        "spacing": 8,
        "tooltip": true
    }
}
