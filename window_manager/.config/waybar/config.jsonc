{
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,
    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [
        "custom/calendar"
    ],
    "modules-right": [
        "sway/scratchpad",
        "custom/cpu",
        "custom/memory",
        "custom/disk",
        "custom/gpu",
        "custom/volume",
        "tray"
    ],
    "sway/workspaces": {
        "format": "{index}",
        "on-click": "activate",
        "tooltip": false
    },
    "sway/scratchpad": {
        "format": "[{count}]"
    },
    "sway/mode": {
        "format": "{}",
   		"tooltip": false
    },
    "custom/cpu": {
        "format": "cpu {} :: ",
        "exec": "$HOME/.config/sway/scripts/cpu_usage",
        "interval": 2,
        "on-click": "alacritty -T \"System Monitor (btop)\" -e btop",
        "tooltip": false
    },
    "custom/memory": {
        "format": "mem {} :: ",
        "exec": "$HOME/.config/sway/scripts/memory",
        "interval": 2,
        "tooltip": false
    },
    "custom/disk": {
        "format": "dsk {} :: ",
        "exec": "$HOME/.config/sway/scripts/disk",
        "interval": 30,
        "tooltip": false
    },
    "custom/gpu": {
        "format": "gpu {} :: ",
        "exec": "$HOME/.config/sway/scripts/gpu_usage",
        "interval": 2,
        "env": {
            "GPU_BRAND": "AMD"
        },
        "on-click": "amdgpu_top --gui",
        "tooltip": false
    },
    "custom/volume": {
        "format": "vol {} :: ",
        "exec": "$HOME/.config/sway/scripts/volume",
        "interval": 1,
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
        "tooltip": false
    },
    "custom/calendar": {
        "format": "{}",
        "exec": "date +'%A %d %b %H:%M:%S'",
        "interval": 1,
        "tooltip": false
    },
    "tray": {
        "icon-size": 14,
        "spacing": 8,
        "tooltip": true
    }
}
