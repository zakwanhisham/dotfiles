{
    "layer": "top",
    "position": "top",
    "height": 18,
    "margin": [0, 0, 0, 0],
    "font-family": "IosevkaTerm Nerd Font",
    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "custom/cpu",
        "custom/memory",
        "custom/disk",
        "custom/gpu",
        "custom/volume",
        "custom/calendar",
        "tray"
    ],

    // --- Workspaces ---
    "sway/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "on-scroll-up": "swaymsg workspace next",
        "on-scroll-down": "swaymsg workspace prev",
        "tooltip": false
    },

    // --- Window Title (centered) ---
    "sway/window": {
        "format": "{}",
        "max-length": 150,
        "icon": false,
        "separate-outputs": false,
        "tooltip": false
    },

    // --- Calendar ---
    "custom/calendar": {
        "format": "{}",
        "exec": "date +'%A-%d-%d %H:%M:%S'",
        "interval": 1,
        "tooltip": false
    },

    // --- CPU Usage ---
    "custom/cpu": {
        "format": "CPU: {}",
        "exec": "/home/ouraaa/.config/sway/scripts/cpu_usage",
        "interval": 2,
        "on-click": "alacritty -T \"System Monitor (btop)\" -e btop",
        "tooltip": false
    },

    // --- Memory Usage ---
    "custom/memory": {
        "format": "MEM: {}",
        "exec": "/home/ouraaa/.config/sway/scripts/memory",
        "interval": 2,
        "tooltip": false
    },

    // --- Disk Usage ---
    "custom/disk": {
        "format": "DISK: {}",
        "exec": "/home/ouraaa/.config/sway/scripts/disk",
        "interval": 30,
        "tooltip": false
    },

    // --- GPU Usage ---
    "custom/gpu": {
        "format": "GPU: {}",
        "exec": "/home/ouraaa/.config/sway/scripts/gpu_usage",
        "interval": 2,
        "env": {
            "GPU_BRAND": "AMD"
        },
        "on-click": "amdgpu_top --gui",
        "tooltip": false
    },

    // --- Volume ---
    "custom/volume": {
        "format": "VOL: {}",
        "exec": "/home/ouraaa/.config/sway/scripts/volume",
        "interval": 1,
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
        "tooltip": false
    },

    // --- System Tray ---
    "tray": {
        "icon-size": 12,
        "spacing": 8,
        "tooltip": false
    }
}

