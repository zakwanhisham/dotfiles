#!/usr/bin/env bash

# Thresholds from environment variables
T_WARN="${T_WARN:-50}"
T_CRIT="${T_CRIT:-80}"
DECIMALS="${DECIMALS:-0}"
LABEL="${LABEL:-}"

# Get CPU usage using mpstat
LC_ALL="en_US"
cpu_idle=$(LC_ALL="$LC_ALL" mpstat 1 1 | awk '/^Average:/ {print $NF}')

if [[ -z "$cpu_idle" ]]; then
    echo "Can't find CPU information" >&2
    exit 1
fi

# Calculate CPU usage (100% - %idle)
cpu_usage=$(awk "BEGIN {printf \"%.${DECIMALS}f\", 100 - $cpu_idle}")

# Print short_text, full_text
printf "%s%0${DECIMALS}.${DECIMALS}f%%\n" "$LABEL" "$cpu_usage"
printf "%s%0${DECIMALS}.${DECIMALS}f%%\n" "$LABEL" "$cpu_usage"

# Print color, if needed
cpu_int=${cpu_usage%.*}
if ((cpu_int >= T_CRIT)); then
    echo "#FF0000"
elif ((cpu_int >= T_WARN)); then
    echo "#FFFC00"
fi

exit 0
