#!/usr/bin/env bash

# Get the default sink
SINK="@DEFAULT_SINK@"

# Get volume and mute status
volume_info=$(pactl get-sink-volume "$SINK" 2>/dev/null)
mute_status=$(pactl get-sink-mute "$SINK" 2>/dev/null)

# Extract volume percentage
volume=$(echo "$volume_info" | grep -oP '\d+%' | head -1 | tr -d '%')
mute=$(echo "$mute_status" | grep -oP '(yes|no)')

# Handle scroll and click actions
case $BLOCK_BUTTON in
1) pactl set-sink-mute "$SINK" toggle ;; # left click: toggle mute
3) pactl set-sink-mute "$SINK" toggle ;; # right click: toggle mute
4) pactl set-sink-volume "$SINK" +5% ;;  # scroll up: increase
5) pactl set-sink-volume "$SINK" -5% ;;  # scroll down: decrease
esac

# Display volume or mute status
if [[ "$mute" == "yes" ]]; then
    echo "MUTE"
else
    echo "${volume}%"
fi

exit 0
