#!/usr/bin/env bash
#
# Use yad to change system runstate thanks to systemd.
#
# Inspired from i3pystatus wiki:
# https://github.com/enkore/i3pystatus/wiki/Shutdown-Menu
#
# Copyright 2015 Benjamin Chrétien <chretien at lirmm dot fr>
#
# This program is free software: you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation, either version 3 of the License, or
# (at your option) any later version.

# Modified to use yad instead of rofi/zenity

#######################################################################
#                            BEGIN CONFIG                             #
#######################################################################

# Yad options
YAD_TITLE="Power Menu"
YAD_WIDTH=200
YAD_HEIGHT=200
YAD_OPTIONS=(--fixed --on-top --center --skip-taskbar)

#######################################################################
#                             END CONFIG                              #
#######################################################################

# Whether to ask for user's confirmation
enable_confirmation=false

usage="$(basename "$0") [-h] [-c] -- display a menu for shutdown, reboot, lock etc.

where:
    -h  show this help text
    -c  ask for user confirmation

This script depends on:
  - systemd,
  - sway/i3,
  - yad."

# Parse CLI arguments
while getopts "hc" option; do
  case "${option}" in
    h) echo "${usage}"
       exit 0
       ;;
    c) enable_confirmation=true
       ;;
    *) exit 1
       ;;
  esac
done

# Check whether a command exists
function command_exists() {
  command -v "$1" &> /dev/null 2>&1
}

# systemctl required
if ! command_exists systemctl ; then
  exit 1
fi

# yad required
if ! command_exists yad ; then
  echo "Error: yad is required but not installed."
  exit 1
fi

# Menu items with their commands
declare -A menu
menu[" Shutdown"]="systemctl poweroff"
menu[" Reboot"]="systemctl reboot"
menu[" Suspend"]="systemctl suspend"
menu[" Hibernate"]="systemctl hibernate"
menu[" Lock"]="~/.config/sway/scripts/blur-lock"
menu[" Logout"]="swaymsg exit"

# Order of items in the list (top to bottom)
menu_items=("  Lock" "  Logout" "  Suspend" "  Hibernate" "  Reboot" "  Shutdown")

# Menu entries that may trigger a confirmation message
menu_confirm="Shutdown Reboot Hibernate Suspend Logout"

# Build menu list for yad
menu_list=""
for item in "${menu_items[@]}"; do
  menu_list+="${item}"$'\n'
done

# Display menu using yad list mode
selection=$(printf '%s' "$menu_list" | yad --list \
  --title="${YAD_TITLE}" \
  --width="${YAD_WIDTH}" \
  --height="${YAD_HEIGHT}" \
  --column="" \
  --hide-header \
  --no-headers \
  "${YAD_OPTIONS[@]}")

# Exit if no selection or Cancel was chosen
if [[ -z "${selection}" || "${selection}" == "Cancel" ]]; then
  exit 0
fi

# Confirm dangerous actions
function ask_confirmation() {
  # Strip icon from selection for display
  local action_name="${selection#* }"
  yad --question \
    --title="Confirm" \
    --text="Are you sure you want to ${action_name}?" \
    --button=Yes:0 \
    --button=No:1 \
    "${YAD_OPTIONS[@]}"
  return $?
}

# Execute the action
if [[ -n "${menu[${selection}]}" ]]; then
  if [[ "${enable_confirmation}" = true && "${menu_confirm}" =~ (^|[[:space:]])"${selection}"($|[[:space:]]) ]]; then
    if ask_confirmation; then
      swaymsg -q "exec --no-startup-id ${menu[${selection}]}"
    fi
  else
    swaymsg -q "exec --no-startup-id ${menu[${selection}]}"
  fi
fi
